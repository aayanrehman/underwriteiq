# Copy to .env and fill in — never commit .env itself.
# The deterministic engine needs NO secrets.

# SQLite path (optional; default data/underwriteiq.db)
UNDERWRITEIQ_DB=

# Synthetic book size generated on API startup (default 5000)
UNDERWRITEIQ_BOOK_SIZE=

# Enables Claude memo drafting; without it the verified template is used.
ANTHROPIC_API_KEY=
