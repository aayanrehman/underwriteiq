# Copy to .env and fill in — never commit .env itself.
# UnderwriteIQ's deterministic core needs NO secrets; this file only matters
# if you wire up an LLM provider for the agent layer (.agents/skills/).

# SQLite path (optional; default data/underwriteiq.db)
UNDERWRITEIQ_DB=

# LLM provider (only needed for the agent layer — not used by src/)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Postgres (future swap-in; current Store implementation targets SQLite)
DATABASE_URL=
